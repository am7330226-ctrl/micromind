VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional — enables the online Gemini AI Copilot engine.
# Without it, the Copilot falls back to a local rule-based engine.
# You can also paste a key directly in-app via Settings, which is stored in localStorage instead.
VITE_GEMINI_API_KEY=your-gemini-api-key
